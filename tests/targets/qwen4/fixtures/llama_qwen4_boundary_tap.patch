+static void common_debug_print_token_summaries(
+        const char * name, uint8_t * data, ggml_type type, const int64_t * ne, const size_t * nb) {
+    if (ne[2] <= 0 || ne[3] != 1) {
+        return;
+    }
+    for (int64_t i2 = 0; i2 < ne[2]; ++i2) {
+        double sum = 0.0;
+        double sumsq = 0.0;
+        float max_abs = 0.0f;
+        for (int64_t i1 = 0; i1 < ne[1]; ++i1) {
+            for (int64_t i0 = 0; i0 < ne[0]; ++i0) {
+                const float value = common_ggml_get_float_value(data, type, nb, i0, i1, i2, 0);
+                sum += value;
+                sumsq += (double) value * value;
+                max_abs = std::max(max_abs, std::abs(value));
+            }
+        }
+        LOG("NINFER_QWEN4_TAP name=%s token=%lld sum=%.17g sumsq=%.17g max_abs=%.9g\n",
+            name, (long long) i2, sum, sumsq, (double) max_abs);
+    }
+}
