+inline bool IsUTF8ContinuationByte(uint8_t byte, int32_t remaining, TCodepoint partial) {
+  if ((byte & 0xC0) != 0x80) return false;
+  // After a valid four-byte second byte, partial is at least 16. E0/ED prefixes
+  // therefore remain distinguishable using the existing partial codepoint.
+  if (remaining == 2) {
+    if (partial == 0 && byte < 0xA0) return false;
+    if (partial == 0xD && byte > 0x9F) return false;
+  } else if (remaining == 3) {
+    if (partial == 0 && byte < 0x90) return false;
+    if (partial == 4 && byte > 0x8F) return false;
+  }
+  return true;
+}
